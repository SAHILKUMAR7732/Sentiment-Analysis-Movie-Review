# Environment Variables Template
# Copy this file to .env if you wish to configure local environment variables.
# Do not store real API keys, secrets, or tokens in this file.

# Dataset cache directory (optional override)
# HF_DATASETS_CACHE=./data/raw

# PyTorch device override (e.g. cpu, cuda, auto)
DEVICE_OVERRIDE=auto

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
